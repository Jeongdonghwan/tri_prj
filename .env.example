FLASK_APP=app
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bbe_shop

APP_NAME=트리플업
KAKAO_CHAT_URL=http://pf.kakao.com/_uuxgxaX/chat

# 순위 서버(rankserver) 연동
#  - RANK_API_TOKEN: rankserver .env 의 NSR_PARTNER_TOKEN 과 동일한 값
#  - RANK_CALLBACK_TOKEN: 콜백 수신 검증용 (같은 값 공용 권장)
#  - rankserver 쪽 NSR_PARTNER_CALLBACK_URL 은 http://<이 서버>:<포트>/api/rank/callback
RANK_SERVER_URL=https://rank.mbizsquare.com
RANK_API_TOKEN=
RANK_CALLBACK_TOKEN=

# Naver Search Ad API (비우면 더미 데이터) https://manage.searchad.naver.com > 도구 > API 사용 관리
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 개발용 로그인 (FLASK_DEBUG=1 일 때만 동작)
DEV_LOGIN=0
